{
  "name": "@hortinis/plants",
  "version": "0.0.0",
  "private": true,
  "description": "Versioned plant reference catalog and release tooling for Hortinis.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@11.26.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.26.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && node dist/schema/compile-schema-registry.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "tsc --project tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "import:grow": "pnpm build && node dist/adapters/grow/cli.js",
    "import:cropgraph": "pnpm build && node dist/adapters/cropgraph/cli.js",
    "import:wfo": "pnpm build && node dist/adapters/wfo/cli.js",
    "verify:taxref-pin": "pnpm build && node dist/adapters/taxref/verify-pin-cli.js",
    "curate:grow-wfo:drafts": "pnpm build && node dist/curation/grow-wfo-drafts-cli.js",
    "curate:wfo:lookup": "pnpm build && node dist/curation/wfo-lookup-cli.js",
    "curate:grow-wfo:validate": "pnpm build && node dist/curation/grow-wfo-validation-cli.js",
    "curate:grow-wfo:status": "pnpm build && node dist/curation/grow-wfo-status-cli.js",
    "curate:grow-wfo:show": "pnpm build && node dist/curation/grow-wfo-show-cli.js",
    "curate:grow-wfo:apply": "pnpm build && node dist/curation/grow-wfo-apply-cli.js"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "csv-parse": "^6.2.1",
    "exceljs": "^4.4.0",
    "stream-json": "^3.7.0",
    "unzipper": "0.10.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.11"
  }
}
