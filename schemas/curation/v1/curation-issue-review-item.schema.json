{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hortinis:plants:schema:curation:v1:curation-issue-review-item",
  "title": "Generated curation issue review item",
  "type": "object",
  "required": [
    "id",
    "kind",
    "status",
    "reviewState",
    "affectedRecordIds",
    "reason"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "kind": { "const": "unresolved-mapping" },
    "status": { "const": "open" },
    "reviewState": { "const": "unreviewed" },
    "affectedRecordIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "reason": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
