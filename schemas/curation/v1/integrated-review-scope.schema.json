{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hortinis:plants:schema:curation:v1:integrated-review-scope",
  "title": "Frozen integrated review scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewState",
    "policy",
    "sources",
    "fingerprints",
    "counts"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "reviewState": { "const": "unreviewed" },
    "policy": { "const": "qualified-source-record-v1" },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/source" }
    },
    "fingerprints": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/fingerprint" }
    },
    "counts": {
      "type": "array",
      "items": { "$ref": "#/$defs/count" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "sourceId", "sourceManifestId", "sourceReleaseId"],
      "properties": {
        "kind": { "enum": ["grow", "cropgraph", "wfo", "taxref"] },
        "sourceId": { "type": "string", "minLength": 1 },
        "sourceManifestId": { "type": "string", "minLength": 1 },
        "sourceReleaseId": { "type": "string", "minLength": 1 },
        "rights": { "type": "object" }
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "sha256", "byteSize"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "sha256": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/sha256"
        },
        "byteSize": { "type": "integer", "minimum": 0 },
        "recordCount": { "type": "integer", "minimum": 0 }
      }
    },
    "count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "count"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
