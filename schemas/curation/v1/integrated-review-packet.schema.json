{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hortinis:plants:schema:curation:v1:integrated-review-packet",
  "title": "Hortinis integrated source-record review packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "packetVersion",
    "reviewState",
    "grouping",
    "sourceKind",
    "sourceRecordKey",
    "sourceRecord",
    "identityCandidates",
    "cultivationCandidates",
    "taxonomyOutcomes",
    "localizationOutcomes",
    "localizationProposals",
    "authoredDecisions",
    "rightsEvidence",
    "queueMembership",
    "comparisonIds",
    "dependencies",
    "contentSha256"
  ],
  "properties": {
    "id": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
    },
    "packetVersion": { "const": "1.0.0" },
    "reviewState": { "const": "unreviewed" },
    "grouping": { "const": "qualified-source-record-v1" },
    "sourceKind": { "enum": ["grow", "cropgraph"] },
    "sourceRecordKey": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/qualifiedSourceRecordKey"
    },
    "sourceRecord": { "type": "object" },
    "identityCandidates": {
      "type": "array",
      "items": { "type": "object" }
    },
    "cultivationCandidates": {
      "type": "array",
      "items": { "type": "object" }
    },
    "taxonomyOutcomes": {
      "type": "array",
      "items": { "type": "object" }
    },
    "localizationOutcomes": {
      "type": "array",
      "items": { "type": "object" }
    },
    "localizationProposals": {
      "type": "array",
      "items": { "type": "object" }
    },
    "authoredDecisions": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": { "type": "object" }
      }
    },
    "rightsEvidence": { "type": "object" },
    "queueMembership": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "comparisonIds": {
      "type": "array",
      "items": {
        "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
      },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/dependency" }
    },
    "contentSha256": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/sha256"
    }
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "sha256"],
      "properties": {
        "role": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
        },
        "sha256": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/sha256"
        },
        "recordCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
