{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hortinis:plants:schema:curation:v1:identity-review-item",
  "title": "GROW source identity review item",
  "type": "object",
  "required": [
    "id",
    "reviewState",
    "sourceRecord",
    "taxonomyCandidate",
    "proposedNextStep"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "reviewState": { "const": "unreviewed" },
    "sourceRecord": { "type": "object" },
    "taxonomyCandidate": {
      "$ref": "urn:hortinis:plants:schema:v1:taxon-match-candidate"
    },
    "proposedNextStep": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
