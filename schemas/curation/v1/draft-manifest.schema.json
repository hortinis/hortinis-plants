{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hortinis:plants:schema:curation:v1:draft-manifest",
  "title": "Hortinis generated curation draft manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "reviewState",
    "inputs",
    "scopes",
    "queues",
    "packets",
    "outputs",
    "counts"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "kind": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
    },
    "reviewState": { "const": "unreviewed" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/input" }
    },
    "scopes": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "queues": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "packets": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "outputs": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "counts": { "type": "array", "items": { "$ref": "#/$defs/count" } }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "locator", "sha256", "byteSize"],
      "properties": {
        "role": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
        },
        "id": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
        },
        "locator": { "type": "string", "minLength": 1 },
        "schemaId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
        },
        "sha256": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/sha256"
        },
        "byteSize": { "type": "integer", "minimum": 0 },
        "recordCount": { "type": "integer", "minimum": 0 },
        "configurationSha256": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/sha256"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "sha256", "byteSize"],
      "properties": {
        "role": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
        },
        "path": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/safeRelativePath"
        },
        "locator": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string", "minLength": 1 },
        "schemaId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
        },
        "sha256": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/sha256"
        },
        "byteSize": { "type": "integer", "minimum": 0 },
        "recordCount": { "type": "integer", "minimum": 0 }
      },
      "anyOf": [
        {
          "required": ["path"],
          "properties": {
            "path": {
              "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/safeRelativePath"
            }
          }
        },
        {
          "required": ["locator"],
          "properties": { "locator": { "type": "string", "minLength": 1 } }
        }
      ]
    },
    "count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "count"],
      "properties": {
        "role": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
        },
        "count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
