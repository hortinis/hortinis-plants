{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hortinis:plants:schema:v1:chunk-descriptor",
  "title": "Hortinis catalog JSON Lines chunk descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "path",
    "kind",
    "mediaType",
    "schemaId",
    "contentEncoding",
    "byteSize",
    "entryCount",
    "sha256"
  ],
  "properties": {
    "path": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/safeRelativePath"
    },
    "kind": { "const": "jsonl-gzip" },
    "mediaType": { "const": "application/x-ndjson" },
    "schemaId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:" },
    "contentEncoding": { "const": "gzip" },
    "byteSize": { "type": "integer", "minimum": 0 },
    "entryCount": { "type": "integer", "minimum": 0 },
    "sha256": { "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/sha256" }
  }
}
