{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hortinis:plants:schema:v1:review",
  "title": "Hortinis catalog review",
  "type": "object",
  "required": ["id", "status"],
  "properties": {
    "id": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
    },
    "status": {
      "type": "string",
      "enum": ["unreviewed", "accepted", "rejected", "superseded"]
    },
    "reviewedAt": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/utcTimestamp"
    },
    "reviewerId": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "notes": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "enum": ["accepted", "rejected", "superseded"] }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "reviewedAt": true,
          "reviewerId": true
        },
        "required": ["reviewedAt", "reviewerId"]
      }
    }
  ]
}
