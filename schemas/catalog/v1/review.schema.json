{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hortinis:plants:schema:v1:review",
  "title": "Hortinis catalog review decision",
  "type": "object",
  "required": ["id", "purpose", "status"],
  "properties": {
    "id": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
    },
    "purpose": { "enum": ["content", "rights"] },
    "status": { "enum": ["unreviewed", "accepted", "rejected", "superseded"] },
    "reviewedAt": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/utcTimestamp"
    },
    "reviewerId": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "notes": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "enum": ["accepted", "rejected", "superseded"] }
        },
        "required": ["status"]
      },
      "then": {
        "required": ["reviewedAt", "reviewerId"],
        "properties": { "reviewedAt": true, "reviewerId": true }
      }
    },
    {
      "if": {
        "properties": { "purpose": { "const": "rights" } },
        "required": ["purpose"]
      },
      "then": { "properties": { "confidence": false } }
    }
  ]
}
