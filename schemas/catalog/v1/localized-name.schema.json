{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hortinis:plants:schema:v1:localized-name",
  "title": "Hortinis catalog localized name",
  "type": "object",
  "required": [
    "id",
    "subject",
    "languageTag",
    "value",
    "kind",
    "preferred",
    "evidenceReferenceIds"
  ],
  "properties": {
    "id": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {
          "enum": ["taxon", "plant-concept", "cultivar-group", "cultivar"]
        },
        "id": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
        }
      }
    },
    "languageTag": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/languageTag"
    },
    "value": { "type": "string", "minLength": 1 },
    "kind": { "type": "string", "enum": ["common", "alias"] },
    "preferred": { "type": "boolean" },
    "evidenceReferenceIds": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/identifierList"
    }
  }
}
