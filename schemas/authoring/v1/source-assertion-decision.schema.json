{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hortinis:plants:schema:authoring:v1:source-assertion-decision",
  "title": "Reviewed source assertion decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "sourceCandidateId",
    "draftManifestSha256",
    "decision",
    "reason",
    "reviewId"
  ],
  "properties": {
    "id": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
    },
    "sourceCandidateId": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
    },
    "draftManifestSha256": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/sha256"
    },
    "decision": { "enum": ["accept", "reject", "defer"] },
    "reason": { "type": "string", "minLength": 1 },
    "reviewId": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
    },
    "assertionId": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
    },
    "contextId": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
    },
    "sourceAction": { "type": "string", "minLength": 1 },
    "sourceTiming": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/jsonValue"
    },
    "mappingMethod": {
      "enum": [
        "identity",
        "combined-action-preserved",
        "normalized-source-timing"
      ]
    },
    "deferralReason": {
      "enum": [
        "dynamic-plant-now",
        "ambiguous-action",
        "ambiguous-soil-temperature",
        "missing-timing-anchor"
      ]
    },
    "projectionIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "action", "timing"],
      "properties": {
        "type": { "const": "cultivation-rule" },
        "action": {
          "$ref": "urn:hortinis:plants:schema:v1:cultivation-rule#/$defs/action"
        },
        "timing": {
          "$ref": "urn:hortinis:plants:schema:v1:cultivation-rule#/$defs/timing"
        }
      }
    },
    "supersedesDecisionId": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "decision": { "const": "accept" } },
        "required": ["decision"]
      },
      "then": {
        "required": ["assertionId", "contextId"],
        "properties": { "assertionId": true, "contextId": true }
      },
      "else": {
        "properties": {
          "assertionId": false,
          "contextId": false,
          "projectionIntent": false
        }
      }
    },
    {
      "if": {
        "required": ["projectionIntent"]
      },
      "then": {
        "type": "object",
        "properties": {
          "sourceAction": true,
          "sourceTiming": true,
          "mappingMethod": true,
          "deferralReason": false
        },
        "required": ["sourceAction", "sourceTiming", "mappingMethod"]
      }
    },
    {
      "if": {
        "required": ["deferralReason"]
      },
      "then": {
        "type": "object",
        "properties": {
          "sourceAction": true,
          "sourceTiming": true,
          "decision": { "const": "defer" },
          "projectionIntent": false,
          "assertionId": false,
          "contextId": false
        },
        "required": ["sourceAction", "sourceTiming"]
      }
    }
  ]
}
