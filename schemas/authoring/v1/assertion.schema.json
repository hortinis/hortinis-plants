{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hortinis:plants:schema:authoring:v1:assertion",
  "title": "Hortinis authored source assertion",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "subject",
    "predicate",
    "value",
    "contextId",
    "evidenceReferenceIds",
    "reviewId"
  ],
  "properties": {
    "id": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
    },
    "subject": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/subjectReference"
    },
    "predicate": {
      "enum": [
        "life_cycle",
        "growth_habit",
        "mature_height",
        "mature_spread",
        "sun_requirement",
        "soil_texture",
        "soil_ph_range",
        "drainage_requirement",
        "water_requirement",
        "frost_sensitivity",
        "minimum_germination_temperature",
        "germination_profile",
        "growing_temperature",
        "germination_days",
        "days_to_first_harvest",
        "spacing",
        "sowing_window",
        "transplant_window",
        "harvest_window",
        "cultivation_window",
        "growing_degree_days"
      ]
    },
    "value": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/jsonValue"
    },
    "contextId": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
    },
    "evidenceReferenceIds": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/identifierList"
    },
    "reviewId": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "predicate": { "const": "growing_temperature" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": {
            "$ref": "urn:hortinis:plants:schema:v1:temperature-profile"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "germination_profile" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": {
            "$ref": "urn:hortinis:plants:schema:v1:germination-profile"
          }
        }
      }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "cultivation_window" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "timing",
              "sourceAction",
              "sourceTiming",
              "mappingMethod"
            ],
            "properties": {
              "action": {
                "$ref": "urn:hortinis:plants:schema:v1:cultivation-rule#/$defs/action"
              },
              "timing": {
                "$ref": "urn:hortinis:plants:schema:v1:cultivation-rule#/$defs/timing"
              },
              "sourceAction": { "type": "string", "minLength": 1 },
              "sourceTiming": {
                "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/jsonValue"
              },
              "mappingMethod": {
                "enum": [
                  "identity",
                  "combined-action-preserved",
                  "normalized-source-timing"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "predicate": {
            "enum": ["sowing_window", "transplant_window", "harvest_window"]
          }
        },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": {
            "oneOf": [
              {
                "$ref": "urn:hortinis:plants:schema:v1:cultivation-rule#/$defs/calendarMonthWindow"
              },
              {
                "$ref": "urn:hortinis:plants:schema:v1:cultivation-rule#/$defs/calendarDateWindow"
              },
              {
                "$ref": "urn:hortinis:plants:schema:v1:cultivation-rule#/$defs/relativeDayWindow"
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "predicate": { "const": "growing_degree_days" } },
        "required": ["predicate"]
      },
      "then": {
        "properties": {
          "value": {
            "$ref": "urn:hortinis:plants:schema:v1:cultivation-rule#/$defs/growingDegreeDayThreshold"
          }
        }
      }
    }
  ]
}
