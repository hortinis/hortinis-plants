{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hortinis:plants:schema:authoring:v1:source-name-decision",
  "title": "Reviewed source name decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "sourceName",
    "sourceLocator",
    "decision",
    "reason",
    "reviewId"
  ],
  "properties": {
    "id": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
    },
    "sourceRecordKey": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/qualifiedSourceRecordKey"
    },
    "sourceId": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
    },
    "sourceManifestId": {
      "$ref": "urn:hortinis:plants:schema:v1:source-manifest#/$defs/sourceManifestId"
    },
    "sourceReleaseId": { "type": "string", "minLength": 1 },
    "sourceRecordId": { "type": "string", "minLength": 1 },
    "sourceName": { "type": "string", "minLength": 1 },
    "sourceLocator": { "type": "string", "minLength": 1 },
    "decision": {
      "enum": [
        "accept-candidate",
        "manual-match",
        "documented-correction",
        "unresolved",
        "not-taxonomic",
        "reject"
      ]
    },
    "externalTaxonomyCrosswalkId": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
    },
    "correctedComparisonName": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "reviewId": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
    },
    "supersedesDecisionId": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "required": ["sourceRecordKey"],
          "properties": { "sourceRecordKey": true }
        },
        {
          "required": [
            "sourceId",
            "sourceManifestId",
            "sourceReleaseId",
            "sourceRecordId"
          ],
          "properties": {
            "sourceId": true,
            "sourceManifestId": true,
            "sourceReleaseId": true,
            "sourceRecordId": true
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": [
              "accept-candidate",
              "manual-match",
              "documented-correction"
            ]
          }
        },
        "required": ["decision"]
      },
      "then": {
        "required": ["externalTaxonomyCrosswalkId"],
        "properties": { "externalTaxonomyCrosswalkId": true }
      }
    },
    {
      "if": {
        "properties": {
          "decision": {
            "enum": ["unresolved", "not-taxonomic", "reject"]
          }
        },
        "required": ["decision"]
      },
      "then": {
        "required": ["reason"],
        "properties": {
          "reason": true,
          "externalTaxonomyCrosswalkId": false
        }
      }
    },
    {
      "if": {
        "properties": { "decision": { "const": "documented-correction" } },
        "required": ["decision"]
      },
      "then": {
        "required": ["correctedComparisonName", "reason"],
        "properties": {
          "correctedComparisonName": true,
          "reason": true
        }
      }
    }
  ]
}
