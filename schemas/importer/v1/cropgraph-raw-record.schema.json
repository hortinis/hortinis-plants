{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hortinis:plants:schema:v1:cropgraph-raw-record",
  "title": "CropGraph raw source record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceRecordKey",
    "sourceLocator",
    "originalIndex",
    "rawEntry",
    "effectiveCitation",
    "citationLevel",
    "declaredLicence",
    "commercialRights"
  ],
  "properties": {
    "sourceRecordKey": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/qualifiedSourceRecordKey"
    },
    "sourceLocator": { "type": "string", "minLength": 1 },
    "originalIndex": { "type": "integer", "minimum": 0 },
    "rawEntry": { "type": "object" },
    "effectiveCitation": { "type": "string" },
    "citationLevel": { "enum": ["entry", "calendar"] },
    "declaredLicence": { "const": "CC-BY-4.0" },
    "commercialRights": { "const": "pending-review" }
  }
}
