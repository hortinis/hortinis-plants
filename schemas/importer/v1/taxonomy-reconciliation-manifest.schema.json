{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hortinis:plants:schema:v1:taxonomy-reconciliation-manifest",
  "title": "Taxonomy reconciliation run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "job",
    "sourceManifests",
    "inputs",
    "configuration",
    "configurationSha256",
    "tools",
    "outputs",
    "counts"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/semanticVersion"
        }
      }
    },
    "sourceManifests": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sha256"],
        "properties": {
          "id": {
            "$ref": "urn:hortinis:plants:schema:v1:source-manifest#/$defs/sourceManifestId"
          },
          "sha256": {
            "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/sha256"
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["locator", "sha256", "byteSize", "role"],
        "properties": {
          "locator": { "type": "string", "minLength": 1 },
          "sha256": {
            "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/sha256"
          },
          "byteSize": { "type": "integer", "minimum": 0 },
          "role": { "enum": ["source-snapshot", "importer-output"] }
        }
      }
    },
    "configuration": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/jsonValue"
    },
    "configurationSha256": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/sha256"
    },
    "tools": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "schemaId", "sha256", "byteSize", "recordCount"],
        "properties": {
          "path": {
            "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/safeRelativePath"
          },
          "schemaId": { "type": "string", "minLength": 1 },
          "sha256": {
            "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/sha256"
          },
          "byteSize": { "type": "integer", "minimum": 0 },
          "recordCount": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "growRecords",
        "uniqueInputNames",
        "candidateAccepted",
        "candidateSynonym",
        "ambiguous",
        "unplaced",
        "unresolvedStatus",
        "unmatched",
        "wfoRowsScanned",
        "selectedWfoRecords",
        "unresolvedMappings"
      ],
      "properties": {
        "growRecords": { "type": "integer", "minimum": 0 },
        "uniqueInputNames": { "type": "integer", "minimum": 0 },
        "candidateAccepted": { "type": "integer", "minimum": 0 },
        "candidateSynonym": { "type": "integer", "minimum": 0 },
        "ambiguous": { "type": "integer", "minimum": 0 },
        "unplaced": { "type": "integer", "minimum": 0 },
        "unresolvedStatus": { "type": "integer", "minimum": 0 },
        "unmatched": { "type": "integer", "minimum": 0 },
        "wfoRowsScanned": { "type": "integer", "minimum": 0 },
        "selectedWfoRecords": { "type": "integer", "minimum": 0 },
        "unresolvedMappings": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
