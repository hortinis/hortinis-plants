{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hortinis:plants:schema:v1:taxonomy-reconciliation-manifest",
  "title": "Taxonomy reconciliation run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "job",
    "inputs",
    "configuration",
    "configurationSha256",
    "tools",
    "outputs",
    "counts"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/semanticVersion"
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/input" }
    },
    "configuration": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/jsonValue"
    },
    "configurationSha256": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/sha256"
    },
    "tools": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "sha256", "byteSize"],
        "properties": {
          "path": {
            "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/safeRelativePath"
          },
          "role": {
            "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
          },
          "schemaId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
          },
          "sha256": {
            "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/sha256"
          },
          "byteSize": { "type": "integer", "minimum": 0 },
          "recordCount": { "type": "integer", "minimum": 0 },
          "mediaType": { "type": "string", "minLength": 1 }
        }
      }
    },
    "counts": {
      "type": "array",
      "items": { "$ref": "#/$defs/count" }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "locator", "sha256", "byteSize"],
      "properties": {
        "role": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
        },
        "id": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
        },
        "locator": { "type": "string", "minLength": 1 },
        "schemaId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
        },
        "sha256": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/sha256"
        },
        "byteSize": { "type": "integer", "minimum": 0 },
        "recordCount": { "type": "integer", "minimum": 0 },
        "configurationSha256": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/sha256"
        }
      }
    },
    "count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "count"],
      "properties": {
        "role": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
        },
        "count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
