{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hortinis:plants:schema:v1:importer-run-manifest",
  "title": "Hortinis importer run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "importer",
    "sourceManifest",
    "inputs",
    "configuration",
    "configurationSha256",
    "tools",
    "outputs",
    "counts"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "importer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/semanticVersion"
        }
      }
    },
    "sourceManifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256"],
      "properties": {
        "id": {
          "$ref": "urn:hortinis:plants:schema:v1:source-manifest#/$defs/sourceManifestId"
        },
        "sha256": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/sha256"
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/input" }
    },
    "configuration": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/jsonValue"
    },
    "configurationSha256": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/sha256"
    },
    "tools": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "outputs": {
      "type": "array",
      "items": { "$ref": "#/$defs/output" }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertions",
        "warnings",
        "rejectedRecords",
        "unresolvedMappings"
      ],
      "properties": {
        "assertions": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "rejectedRecords": { "type": "integer", "minimum": 0 },
        "unresolvedMappings": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locator", "sha256", "byteSize", "role"],
      "properties": {
        "locator": { "type": "string", "minLength": 1 },
        "sha256": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/sha256"
        },
        "byteSize": { "type": "integer", "minimum": 0 },
        "role": { "enum": ["upstream", "derived"] },
        "derivedFrom": { "type": "string", "minLength": 1 },
        "preparation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "version", "command"],
          "properties": {
            "tool": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "command": { "type": "string", "minLength": 1 }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "role": { "const": "derived" } },
            "required": ["role"]
          },
          "then": {
            "required": ["derivedFrom", "preparation"],
            "properties": {
              "derivedFrom": { "type": "string", "minLength": 1 },
              "preparation": { "$ref": "#/$defs/input/properties/preparation" }
            }
          }
        }
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "mediaType",
        "sha256",
        "byteSize",
        "recordCount"
      ],
      "properties": {
        "path": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/safeRelativePath"
        },
        "role": {
          "enum": ["assertions", "evidence", "diagnostics", "auxiliary"]
        },
        "mediaType": { "type": "string", "minLength": 1 },
        "schemaId": { "type": "string", "minLength": 1 },
        "sha256": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/sha256"
        },
        "byteSize": { "type": "integer", "minimum": 0 },
        "recordCount": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "role": { "enum": ["assertions", "diagnostics"] } },
            "required": ["role"]
          },
          "then": {
            "required": ["schemaId"],
            "properties": { "schemaId": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    }
  }
}
