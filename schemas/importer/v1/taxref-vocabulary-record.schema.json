{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hortinis:plants:schema:v1:taxref-vocabulary-record",
  "title": "TAXREF vocabulary record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "vocabulary",
    "code",
    "sourceLocator",
    "recordNumber",
    "rawRecord"
  ],
  "properties": {
    "vocabulary": { "enum": ["rank", "habitat", "territory-status"] },
    "code": { "type": "string", "minLength": 1 },
    "sourceLocator": { "type": "string", "minLength": 1 },
    "recordNumber": { "type": "integer", "minimum": 1 },
    "rawRecord": {
      "type": "object",
      "minProperties": 3,
      "additionalProperties": { "type": "string" }
    }
  }
}
