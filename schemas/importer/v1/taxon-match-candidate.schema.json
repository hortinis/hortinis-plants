{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hortinis:plants:schema:v1:taxon-match-candidate",
  "title": "External taxonomy name match candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "source",
    "snapshot",
    "sourceName",
    "comparisonName",
    "normalization",
    "outcome",
    "alternatives",
    "reviewState"
  ],
  "properties": {
    "id": {
      "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceLocator"],
      "properties": {
        "sourceRecordKey": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/qualifiedSourceRecordKey"
        },
        "sourceId": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
        },
        "sourceManifestId": {
          "$ref": "urn:hortinis:plants:schema:v1:source-manifest#/$defs/sourceManifestId"
        },
        "sourceReleaseId": { "type": "string", "minLength": 1 },
        "sourceRecordId": { "type": "string", "minLength": 1 },
        "sourceLocator": { "type": "string", "minLength": 1 }
      },
      "anyOf": [
        {
          "required": ["sourceRecordKey"],
          "properties": { "sourceRecordKey": true }
        },
        {
          "required": [
            "sourceId",
            "sourceManifestId",
            "sourceReleaseId",
            "sourceRecordId"
          ],
          "properties": {
            "sourceId": true,
            "sourceManifestId": true,
            "sourceReleaseId": true,
            "sourceRecordId": true
          }
        }
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceManifestId", "sourceReleaseId", "sha256"],
      "properties": {
        "sourceManifestId": {
          "$ref": "urn:hortinis:plants:schema:v1:source-manifest#/$defs/sourceManifestId"
        },
        "sourceReleaseId": { "type": "string", "minLength": 1 },
        "sha256": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/sha256"
        }
      }
    },
    "sourceName": { "type": "string", "minLength": 1 },
    "comparisonName": { "type": "string", "minLength": 1 },
    "normalization": { "const": "unicode-nfc-trim-collapse-whitespace-v1" },
    "outcome": {
      "enum": [
        "candidate-accepted",
        "candidate-synonym",
        "ambiguous",
        "unplaced",
        "unresolved-status",
        "unmatched"
      ]
    },
    "alternatives": {
      "type": "array",
      "items": { "$ref": "#/$defs/alternative" }
    },
    "matchMethod": { "const": "exact-conservative-normalization-v1" },
    "reviewState": { "const": "unreviewed" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "outcome": { "const": "unmatched" } },
        "required": ["outcome"]
      },
      "then": {
        "properties": { "alternatives": { "type": "array", "maxItems": 0 } }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": { "enum": ["candidate-accepted", "candidate-synonym"] }
        },
        "required": ["outcome"]
      },
      "then": {
        "properties": {
          "alternatives": { "type": "array", "minItems": 1, "maxItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "outcome": { "const": "ambiguous" } },
        "required": ["outcome"]
      },
      "then": {
        "properties": { "alternatives": { "type": "array", "minItems": 2 } }
      }
    }
  ],
  "$defs": {
    "externalIdentifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "sourceManifestId",
        "sourceReleaseId",
        "identifier"
      ],
      "properties": {
        "sourceId": {
          "$ref": "urn:hortinis:plants:schema:v1:common#/$defs/stableIdentifier"
        },
        "sourceManifestId": {
          "$ref": "urn:hortinis:plants:schema:v1:source-manifest#/$defs/sourceManifestId"
        },
        "sourceReleaseId": { "type": "string", "minLength": 1 },
        "identifier": { "type": "string", "minLength": 1 }
      }
    },
    "alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "externalIdentifier",
        "scientificName",
        "taxonRank",
        "taxonomicStatus",
        "statusCategory",
        "sourceLocator"
      ],
      "properties": {
        "externalIdentifier": { "$ref": "#/$defs/externalIdentifier" },
        "scientificName": { "type": "string", "minLength": 1 },
        "authorship": { "type": "string", "minLength": 1 },
        "taxonRank": { "type": "string", "minLength": 1 },
        "taxonomicStatus": { "type": "string", "minLength": 1 },
        "statusCategory": {
          "enum": ["accepted", "synonym", "unplaced", "other"]
        },
        "acceptedNameIdentifier": { "type": "string", "minLength": 1 },
        "acceptedName": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "externalIdentifier",
            "scientificName",
            "taxonRank",
            "taxonomicStatus",
            "sourceLocator"
          ],
          "properties": {
            "externalIdentifier": { "$ref": "#/$defs/externalIdentifier" },
            "scientificName": { "type": "string", "minLength": 1 },
            "authorship": { "type": "string", "minLength": 1 },
            "taxonRank": { "type": "string", "minLength": 1 },
            "taxonomicStatus": { "type": "string", "minLength": 1 },
            "sourceLocator": { "type": "string", "minLength": 1 }
          }
        },
        "sourceLocator": { "type": "string", "minLength": 1 }
      }
    }
  }
}
