        "valid": false,
        "errors": [{ "instancePath": "", "keyword": "required" }]
      }
    },
    {
      "id": "source-manifest-empty-resources",
      "schemaId": "urn:hortinis:plants:schema:v1:source-manifest",
      "fixture": "source-manifest-empty-resources.json",
      "expected": {
        "valid": false,
        "errors": [{ "instancePath": "/resources", "keyword": "minItems" }]
