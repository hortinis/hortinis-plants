    {
      "id": "wrong-value-type",
      "fixture": "wrong-value-type.json",
      "expected": {
        "valid": false,
        "errors": [{ "instancePath": "/value", "keyword": "type" }]
      }
    },
    {
      "id": "empty-value",
      "fixture": "empty-value.json",
      "expected": {
        "valid": false,
        "errors": [{ "instancePath": "/value", "keyword": "minLength" }]
      }
    },
    {
      "id": "additional-property",
